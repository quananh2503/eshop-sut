{
  "info": {
    "name": "23127001 HW06 API CI Smoke",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [{
    "listen": "prerequest",
    "script": { "exec": [
      "pm.request.headers.upsert({ key: 'X-Student-Id', value: '23127001' });",
      "console.log('HW06 pre-request: X-Student-Id=23127001');"
    ] }
  }],
  "variable": [{ "key": "baseUrl", "value": "http://127.0.0.1:3000" }],
  "item": [{
    "name": "CI smoke — audited passing behavior",
    "item": [
      {
        "name": "Setup — Login as user",
        "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/api/login", "body": { "mode": "raw", "raw": "{\"email\":\"test@eshop.com\",\"password\":\"Test1234!\"}" } },
        "event": [{ "listen": "test", "script": { "exec": ["pm.test('user login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('userToken', pm.response.json().token);"] } }]
      },
      {
        "name": "Setup — Login as admin",
        "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/api/login", "body": { "mode": "raw", "raw": "{\"email\":\"admin@eshop.com\",\"password\":\"Admin123!\"}" } },
        "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }]
      },
      {
        "name": "Setup — Create owned pending order",
        "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{userToken}}"}], "url": "{{baseUrl}}/api/checkout", "body": { "mode": "raw", "raw": "{\"total_amount\":100000,\"shipping_address\":\"HW06 CI smoke\"}" } },
        "event": [{ "listen": "test", "script": { "exec": ["pm.test('order setup succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('orderId', pm.response.json().orderId);"] } }]
      },
      {
        "name": "LOGIN smoke — token and user contract",
        "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/api/login", "body": { "mode": "raw", "raw": "{\"email\":\"test@eshop.com\",\"password\":\"Test1234!\"}" } },
        "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('token and user object present', () => { const b=pm.response.json(); pm.expect(b.token).to.be.a('string').and.not.empty; pm.expect(b.user).to.be.an('object'); });"] } }]
      },
      {
        "name": "CANCEL smoke — missing JWT is rejected",
        "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/api/orders/{{orderId}}/cancel" },
        "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] } }]
      },
      {
        "name": "ADMINSTATUS smoke — admin confirms pending order",
        "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{adminToken}}"}], "url": "{{baseUrl}}/api/admin/orders/{{orderId}}/status", "body": { "mode": "raw", "raw": "{\"status\":\"confirmed\"}" } },
        "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }]
      }
    ]
  }]
}

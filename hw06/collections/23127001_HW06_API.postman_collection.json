{
  "info": {
    "name": "23127001 HW06 API Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "studentId",
      "value": "23127001"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: pm.variables.replaceIn('{{studentId}}') });",
          "console.log('HW06 pre-request: X-Student-Id=' + pm.variables.replaceIn('{{studentId}}'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login as user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Student-Id",
                "value": "{{studentId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"test@eshop.com\",\"password\":\"Test1234!\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('user login succeeds', () => pm.response.to.have.status(200));",
                  "pm.environment.set('userToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Student-Id",
                "value": "{{studentId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@eshop.com\",\"password\":\"Admin123!\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('admin login succeeds', () => pm.response.to.have.status(200));",
                  "pm.environment.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create owned pending order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Student-Id",
                "value": "{{studentId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\"total_amount\":100000,\"shipping_address\":\"HW06 isolated test data\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('order setup succeeds', () => pm.response.to.have.status(200));",
                  "pm.environment.set('orderId', pm.response.json().orderId);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Login contract smoke",
      "item": [
        {
          "name": "LOGIN-001 valid user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Student-Id",
                "value": "{{studentId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"test@eshop.com\",\"password\":\"Test1234!\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('token/user contract', () => { const b=pm.response.json(); pm.expect(b.token).to.be.a('string').and.not.empty; pm.expect(b.user).to.be.an('object'); });",
                  "pm.test('password not disclosed', () => pm.expect(pm.response.json().user).not.to.have.property('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "LOGIN-020 SQL-like email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Student-Id",
                "value": "{{studentId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"' OR '1'='1\",\"password\":\"x\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('not authenticated', () => pm.expect(pm.response.code).to.be.oneOf([400,401]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Order API smoke",
      "item": [
        {
          "name": "CANCEL missing JWT",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Student-Id",
                "value": "{{studentId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders/1/cancel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('JWT required', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "ADMINSTATUS ordinary user denied",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Student-Id",
                "value": "{{studentId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/orders/{{orderId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"confirmed\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('ordinary user denied', () => pm.expect(pm.response.code).to.be.oneOf([401,403]));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
